# Copy this file to .env.production on the VPS, then fill real secrets.

# Public frontend origin used by FastAPI CORS/security checks.
# Use the exact URL users open in the browser.
FRONTEND_ORIGINS=https://ragcampus.shafwan.digital

# Groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_ROUTER_MODEL=groq/compound-mini
GROQ_ROUTER_FALLBACK_MODEL=openai/gpt-oss-20b
GROQ_ANALYZER_MODEL=groq/compound-mini
GROQ_ANALYZER_FALLBACK_MODEL=qwen/qwen3.8-27b
GROQ_ANSWER_MODEL=groq/compound
GROQ_ANSWER_FALLBACK_MODEL=groq/compound-mini
GROQ_TIMEOUT_SECONDS=60
GROQ_MAX_RETRIES=2

# Embedding provider used for runtime query embedding.
# This must match the provider/model used when indexing data/chroma.
EMBEDDING_PROVIDER=voyage
EMBEDDING_MODEL=voyage-multilingual-2
EMBEDDING_TIMEOUT_SECONDS=60
EMBEDDING_BATCH_SIZE=8
EMBEDDING_MIN_REQUEST_INTERVAL_SECONDS=21
EMBEDDING_MAX_RETRIES=5

# Voyage AI
VOYAGE_API_KEY=your_voyage_api_key_here
VOYAGE_BASE_URL=https://api.voyageai.com/v1

# Optional local embedding fallback
OLLAMA_EMBEDDING_MODEL=bge-m3

# Container paths
CHROMA_DIR=/app/data/chroma
STRUCTURED_FACTS_PATH=/app/data/structured_facts.json
TESSERACT_CMD=/usr/bin/tesseract

# Runtime
APP_ENV=production
STRUCTURED_CACHE_ENABLED=true
STRUCTURED_CACHE_MAX_ENTRIES=256

# Expose the Docker stack only to the VPS host.
# The host Nginx should proxy your public domain/subdomain to this port.
PUBLIC_HTTP_PORT=8081

# Public path for this app under ragcampus.shafwan.digital.
VITE_BASE_PATH=/
VITE_API_BASE_URL=/api
